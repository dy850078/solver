# Tool caches — most versions drop a self-ignoring .gitignore inside, but
# not all, and this project configures both pytest and mypy.
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
venv/
env/
ENV/
.venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Output files
*.csv
*.json
*.xlsx
output/

# Keep example request files (including nested dirs like examples/mock/)
!examples/*.json
!examples/**/*.json
!examples/**/*.csv

# Temporary files
tmp/
temp/
*.tmp
*.bak

# Environment variables
.env
.env.*
